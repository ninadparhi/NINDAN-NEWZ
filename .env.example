# Copy to server/.env (never commit the real file)
PORT=3001
# RSS refresh interval in minutes (clamped to 15-30)
REFRESH_MINUTES=20
# Days of past headlines kept in server/data/archive.json (default 14)
ARCHIVE_DAYS=14

# --- Optional free APIs (all optional; RSS works without any key) ---
# They add publishers that have no public RSS, e.g. Reuters, AP, PTI.
# API results are cached and only re-fetched every API_REFRESH_MINUTES
# so the free tiers are not exhausted by the 20-minute RSS loop.
API_REFRESH_MINUTES=60

# https://newsapi.org/register  (free tier: 100 requests/day, development use)
NEWSAPI_KEY=

# https://gnews.io/  (free tier: 100 requests/day)
GNEWS_API_KEY=

# https://newsdata.io/register  (free tier: 200 credits/day)
NEWSDATA_API_KEY=

# https://open-platform.theguardian.com/access/  (adds images, bylines, trail text)
GUARDIAN_API_KEY=

# Only needed if the client is hosted on a different origin than the API (e.g. Vercel + Render)
CLIENT_ORIGIN=
