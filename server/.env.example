# Copy to .env (never commit the real file)
PORT=3001
REFRESH_MINUTES=20
# Optional: adds Guardian API items (image, author, trail text). https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
# Only needed if the client is hosted on a different origin than the API (e.g. Vercel + Render)
CLIENT_ORIGIN=

# ---- NINDAN-NEWZ 2.0: article analysis ------------------------------------
# No key is required. With nothing set below, /api/analyze-article runs the
# built-in lexical engine and returns the same JSON shape (biasRating,
# biasPercentage, keyTopics, sentence highlights, synthesis).
#
# Optional free backends, in order of convenience:
#   Groq (free tier)       LLM_PROVIDER=groq        GROQ_API_KEY=gsk_...
#   OpenRouter free tier   LLM_PROVIDER=openrouter  OPENROUTER_API_KEY=sk-or-...
#   Hugging Face Inference LLM_PROVIDER=huggingface HF_TOKEN=hf_...
#   Local Ollama (no key)  LLM_PROVIDER=ollama      OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
#   Any OpenAI-compatible  LLM_PROVIDER=openai      LLM_API_KEY=...  LLM_BASE_URL=...
#   Anthropic               LLM_PROVIDER=anthropic   ANTHROPIC_API_KEY=sk-ant-...
#
# Provider is auto-detected from whichever key is present when LLM_PROVIDER is
# empty. A missing, expired or rate-limited key never stops the app: the request
# falls back to the lexical engine and says so in `reason`.
LLM_PROVIDER=
LLM_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=
# Override for an OpenAI-compatible gateway (leave empty for the provider default)
LLM_BASE_URL=
# Local Ollama only
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1:8b
# Max article analyses per IP per 5 minutes
ANALYZE_RATE_MAX=20
# Ingestion-time analyses per refresh (run once per story, stored in archive)
PRECOMPUTE_MAX=40

# ---- Optional Postgres target (see prisma/schema.prisma and README) ----
DATABASE_URL=
